# ==============================================================================
# Homingo Tutor - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (REQUIRED)
# Get your key at: https://aistudio.google.com/app/apikey
# Free tier is sufficient (Gemini 2.5 Flash / Flash Lite / Pro)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Auth (REQUIRED)
# Create a free project at: https://supabase.com
# Find these under: Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Optional: Supabase Direct DB Connection String (if running migrations via CLI or pg driver)
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Text-to-Speech (OPTIONAL - Graceful fallback to Browser Web Speech API)
# Recommended: Google Cloud TTS (generous free tier: 4M chars/month)
# Alternative: ElevenLabs (ELEVENLABS_API_KEY)
# If neither is provided, the app uses browser Web Speech API (speechSynthesis) with hi-IN / en-IN support.
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_TTS_API_KEY=""
# Or ELEVENLABS_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Rate Limiting (OPTIONAL - Postgres-based fallback included)
# Upstash Redis: https://console.upstash.com (Free tier: 10,000 commands/day)
# If omitted, an in-database Supabase rate limiter is used automatically (no extra account needed!)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 5. App URL & Deployment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. Ultra-Fast LLM Acceleration (OPTIONAL - Free sub-second responses)
# Groq Console: https://console.groq.com/keys (100% Free, no credit card required)
# If provided, Groq Llama 3.3 70B runs at 500 tokens/sec with sub-second response times!
# If omitted, Gemini 2.5 Flash is used automatically.
# ------------------------------------------------------------------------------
GROQ_API_KEY=""
